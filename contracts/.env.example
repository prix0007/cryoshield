# CryoShield contract deployment (Arbitrum Sepolia). Copy to contracts/.env (gitignored) and fill in.
# deploy.sh does not read this file itself; load it into your shell first:
#   set -a; source contracts/.env; set +a
#   contracts/script/deploy.sh arbitrum_sepolia            # dry run (simulation only)
#   BROADCAST=1 contracts/script/deploy.sh arbitrum_sepolia # real deploy, writes deployments/421614.json

# Public RPC endpoint for Arbitrum Sepolia (chain 421614). Any provider works.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Name of a Foundry keystore holding the deployer key. A raw private key is refused for public networks.
# Create it once from your private key (you paste the key, then choose a password; nothing is written to disk in plaintext):
#   cast wallet import cryoshield-deployer --interactive
# The account needs a little Arbitrum Sepolia ETH (deploy is ~0.9M gas plus L1 data fee; 0.01 test ETH is plenty).
DEPLOYER_ACCOUNT=cryoshield-deployer

# Arbiscan API key, used to verify the contract source on the explorer. Required when BROADCAST=1.
# Get one at https://arbiscan.io/myapikey
ARBISCAN_API_KEY=REPLACE_ME
