# CryoShield contract deployment (testnet: OP Sepolia, chain 11155420). Copy to contracts/.env (gitignored) and fill in.
# deploy.sh does not read this file itself; load it into your shell first:
#   set -a; source contracts/.env; set +a
#   contracts/script/deploy.sh op_sepolia            # dry run (simulation only)
#   BROADCAST=1 contracts/script/deploy.sh op_sepolia # real deploy, writes deployments/11155420.json, then verifies
#                                                     # the source on Blockscout (keyless: no explorer API key needed)
# Other presets: contracts/script/deploy.sh --list-presets (each reads its own <PRESET>_RPC_URL).

# Public RPC endpoint for OP Sepolia (chain 11155420). Any provider works; deploy.sh checks the chain ID first.
# Alternatives: https://optimism-sepolia-rpc.publicnode.com, https://optimism-sepolia.drpc.org
OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io

# Name of a Foundry keystore holding the deployer key. A raw private key is refused for every public network.
# Create it once from your private key (you paste the key, then choose a password; nothing is written to disk in plaintext):
#   cast wallet import cryoshield-deployer --interactive
# The account needs a little OP Sepolia ETH (deploy is ~0.9M L2 gas plus the L1 data fee; 0.01 test ETH is plenty).
# Faucet: the Superchain faucet, see https://docs.optimism.io/app-developers/tools-sdks/faucets (other faucets are listed
# in openspec/changes/target-op-sepolia/design.md, fact 7), or bridge Ethereum Sepolia ETH through the official OP bridge.
DEPLOYER_ACCOUNT=cryoshield-deployer

# Optional, simulation only: a plain sender address for dry runs without unlocking the keystore. Never a key.
# DEPLOYER_ADDRESS=0x...
