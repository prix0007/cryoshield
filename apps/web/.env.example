# CryoShield web app build configuration. Every value is required; the build fails if one is missing.
# None of these endpoints is operated by CryoShield.

# Chain to use. The registry address and deploy block are read from contracts/deployments/<chainId>.json.
# 42161 = Arbitrum One, 421614 = Arbitrum Sepolia, 31337 = local anvil (E2E).
VITE_CHAIN_ID=421614
# Public JSON-RPC endpoint for reads (eth_call only).
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Private ERC-4337 bundler + ERC-7677 paymaster endpoint (Pimlico). The API key is public by necessity:
# restrict it in the Pimlico dashboard to this site's origin and to bundler/paymaster methods only.
VITE_BUNDLER_URL=https://api.pimlico.io/v2/421614/rpc?apikey=pim_REPLACE_ME
# Pimlico sponsorship policy (per-account + global caps). See apps/web/docs/paymaster-policy.md.
VITE_SPONSORSHIP_POLICY_ID=sp_REPLACE_ME
# ArDrive Turbo upload service (free tier for items <= 105 KiB) and an Arweave gateway (GraphQL + data).
VITE_TURBO_UPLOAD_URL=https://upload.ardrive.io
VITE_ARWEAVE_GATEWAY_URL=https://arweave.net
# WebAuthn relying party. MUST be the host the app is served from (or a registrable suffix of it).
# Changing it later makes existing keys unable to unlock in the browser (desktop recovery still works).
VITE_RP_ID=cryoshield.app
VITE_RP_NAME=CryoShield
