# CryoShield web app build configuration. Every value is required; the build fails if one is missing.
# None of these endpoints is operated by CryoShield.

# Chain to use (a preset; testnet = OP Sepolia, mainnet chain TBD). The registry address and deploy block are read
# from contracts/deployments/<chainId>.json; the build fails if that record is missing.
# Supported: 11155420 = op-sepolia, 10 = op-mainnet, 421614 = arbitrum-sepolia, 42161 = arbitrum-one, 31337 = anvil
VITE_CHAIN_ID=11155420
# Public JSON-RPC endpoint for reads (eth_call only). Must match VITE_CHAIN_ID.
VITE_RPC_URL=https://sepolia.optimism.io
# Private ERC-4337 bundler + ERC-7677 paymaster endpoint (Pimlico). The API key is public by necessity:
# restrict it in the Pimlico dashboard to this site's origin and to bundler/paymaster methods only.
# Pimlico chain slug for OP Sepolia is optimism-sepolia (the numeric chain ID also works in the path).
VITE_BUNDLER_URL=https://api.pimlico.io/v2/optimism-sepolia/rpc?apikey=pim_REPLACE_ME
# Pimlico sponsorship policy (per-account + global caps). See apps/web/docs/paymaster-policy.md.
VITE_SPONSORSHIP_POLICY_ID=sp_REPLACE_ME
# ArDrive Turbo upload service (free tier for items <= 105 KiB) and an Arweave gateway (GraphQL + data).
VITE_TURBO_UPLOAD_URL=https://upload.ardrive.io
VITE_ARWEAVE_GATEWAY_URL=https://arweave.net
# Turbo's fast-finality index: finds the Arweave copy right after upload (arweave.net lists it only after
# settlement, often hours later). Optional; this is the default. App CSP only, never the landing page.
VITE_ARWEAVE_FAST_INDEX_URL=https://turbo-gateway.com
# WebAuthn relying party. MUST be the host the app is served from (or a registrable suffix of it).
# Changing it later makes existing keys unable to unlock in the browser (desktop recovery still works).
VITE_RP_ID=cryoshield.app
VITE_RP_NAME=CryoShield

# Optional: Cloudflare Web Analytics site token (32 hex), landing page (/) only. Unset = no beacon and no Cloudflare
# origin in any CSP. Create the site in Cloudflare Web Analytics with the "manual JS snippet" (no proxy, no DNS change).
# VITE_CF_BEACON_TOKEN=
